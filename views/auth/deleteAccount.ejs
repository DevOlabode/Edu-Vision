<% layout('layout/boilerplate.ejs') %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card shadow-lg" style="border-radius: 20px;">
        <div class="card-body p-5">
          <h2 class="mb-4 text-danger" style="font-weight: 700;"><i class="fas fa-user-times me-2"></i>Delete Account</h2>
          <form action="/delete-account" method="POST">
            <div class="mb-4">
              <label for="password" class="form-label" style="font-weight: 600; color: #2c3e50;">Confirm Password</label>
              <input type="password" class="form-control form-control-lg" id="password" name="password" required placeholder="Enter your password to confirm" style="border-radius: 12px;">
            </div>
            <div class="mb-4">
              <label for="reason" class="form-label" style="font-weight: 600; color: #2c3e50;">Why are you leaving us?</label>
              <textarea class="form-control" id="reason" name="reason" rows="3" required placeholder="Let us know why you're deleting your account..." style="border-radius: 12px;"></textarea>
            </div>
            <div class="mb-3">
              <button type="submit" class="btn btn-danger w-100" style="border-radius: 25px; font-weight: 600; font-size: 1.1rem;">
                <i class="fas fa-user-times me-2"></i>Delete My Account
              </button>
            </div>
            <div class="text-center">
              <a href="/profile" class="btn btn-outline-secondary" style="border-radius: 25px;">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
