<% layout('layout/boilerplate.ejs') %>

<div class="container mt-5">
  <h2 class="mb-4">Search Results for "<%= search %>"</h2>

  <% if ((users && users.length > 0) || (materials && materials.length > 0)) { %>
    <% if (users && users.length > 0) { %>
      <div class="mb-5">
        <h4>Users</h4>
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td><a href="/users/<%= user._id %>"><%= user.firstName %> <%= user.lastName %></a></td>
                <td><%= user.email %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <% if (materials && materials.length > 0) { %>
      <div>
        <h4>Materials</h4>
        <div class="row">
          <% materials.forEach(material => { %>
            <div class="col-md-6 col-lg-4 mb-4">
              <div class="card h-100 shadow-sm border-0" style="border-radius: 18px;">
                <div class="card-body">
                  <h5 class="card-title mb-2" style="font-weight: 700; color: #2c3e50;">
                    <a href="/materials/public/<%= material._id %>" class="text-decoration-none" style="color: #2c3e50; transition: color 0.3s;">
                      <%= material.title %>
                    </a>
                    <div style="font-size: 0.95rem; color: #6c757d; font-weight: 400;">
                      <i class="fas fa-file me-1"></i><%= material.fileName %>
                    </div>
                  </h5>
                  <div class="d-flex flex-wrap gap-2 mt-2">
                    <span class="badge bg-primary">Type: <%= material.fileType.toUpperCase() %></span>
                    <span class="badge bg-secondary">Size: <%= (material.fileSize / 1024).toFixed(2) %> KB</span>
                    <span class="badge bg-success">Status: <%= material.status %></span>
                  </div>
                  <div class="mt-3">
                    <a href="/api/materials/public/<%= material._id %>" class="btn btn-outline-primary btn-sm me-2">View</a>
                    <% if (user && !user.savedMaterials.includes(material._id)) { %>
                      <a href="/save/<%= material._id %>" class="btn btn-outline-success btn-sm">
                        <i class="fas fa-bookmark"></i> Save
                      </a>
                    <% } else if (user && user.savedMaterials.includes(material._id)) { %>
                      <span class="text-success">
                        <i class="fas fa-bookmark"></i> Saved
                      </span>
                    <% } %>
                  </div>
                  <div class="mt-2 text-muted" style="font-size: 0.95rem;">
                    Uploaded by:
                    <% if (material.uploadedBy) { %>
                      <a href="/users/<%= material.uploadedBy._id %>"><%= material.uploadedBy.firstName %> <%= material.uploadedBy.lastName %></a>
                    <% } else { %>
                      <span>Unknown</span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  <% } else { %>
    <div class="alert alert-warning">No users or materials found for your search.</div>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle save button clicks
    document.querySelectorAll('.btn-outline-success').forEach(button => {
        if (button.textContent.includes('Save')) {
            button.addEventListener('click', async function(e) {
                e.preventDefault();
                const materialId = this.getAttribute('href').split('/').pop();

                try {
                    const response = await fetch(`/save/${materialId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Replace button with saved text
                        this.outerHTML = '<span class="text-success"><i class="fas fa-bookmark"></i> Saved</span>';
                    } else {
                        alert('Error: ' + (data.message || 'Failed to save material'));
                    }
                } catch (error) {
                    console.error('Error saving material:', error);
                    alert('Error saving material. Please try again.');
                }
            });
        }
    });
});
</script>
