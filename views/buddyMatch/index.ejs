<% layout('layout/boilerplate') %>

<div class="container-fluid mt-4">
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="welcome-banner" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 20px; padding: 30px; color: white;">
        <h1 class="mb-2">Find Your Study Buddy! 👥</h1>
        <p class="mb-0 opacity-75">Connect with students who share your study preferences and goals</p>
      </div>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Buddy Matching Card -->
      <div class="card mb-4" style="border-radius: 20px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <div class="card-body p-5">
          <!-- Current Preferences Display -->
          <div class="mb-4">
            <h4 class="mb-3"><i class="fas fa-user-cog text-primary me-2"></i>Your Study Preferences</h4>
            <div class="row">
              <div class="col-md-6">
                <div class="preference-item mb-3">
                  <strong>Subjects:</strong>
                  <div class="mt-1">
                    <% if (currentUser.studyPreferences && currentUser.studyPreferences.subjects) { %>
                      <% currentUser.studyPreferences.subjects.forEach(subject => { %>
                        <span class="badge bg-primary me-1"><%= subject %></span>
                      <% }) %>
                    <% } else { %>
                      <span class="text-muted">No subjects set</span>
                    <% } %>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="preference-item mb-3">
                  <strong>Availability:</strong>
                  <div class="mt-1">
                    <% if (currentUser.studyPreferences && currentUser.studyPreferences.availability) { %>
                      <% currentUser.studyPreferences.availability.forEach(time => { %>
                        <span class="badge bg-info me-1"><%= time %></span>
                      <% }) %>
                    <% } else { %>
                      <span class="text-muted">No availability set</span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-12">
                <div class="preference-item">
                  <strong>Goals:</strong>
                  <div class="mt-1">
                    <% if (currentUser.studyPreferences && currentUser.studyPreferences.goals) { %>
                      <p class="mb-0"><%= currentUser.studyPreferences.goals %></p>
                    <% } else { %>
                      <span class="text-muted">No goals set</span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Find Buddy Button -->
          <div class="text-center mb-4">
            <button id="findBuddyBtn" class="btn btn-primary btn-lg" style="padding: 15px 40px; border-radius: 50px; font-weight: 600; font-size: 1.1rem; box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3); transition: all 0.3s ease;">
              <i class="fas fa-search me-2"></i>Find Study Buddy
            </button>
            <p class="text-muted mt-2">We'll match you with someone who shares your study interests!</p>
          </div>

          <!-- Loading Spinner (hidden by default) -->
          <div id="loadingSpinner" class="text-center mb-4" style="display: none;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2">Finding your perfect study buddy...</p>
          </div>

          <!-- Match Result Container -->
          <div id="matchResult" class="match-result" style="display: none;">
            <!-- Success Match -->
            <div id="matchSuccess" style="display: none;">
              <div class="alert alert-success" style="border-radius: 15px; border: none; background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white;">
                <h4 class="alert-heading"><i class="fas fa-check-circle me-2"></i>Potential Study Buddies Found!</h4>
                <p class="mb-3">We've found some potential study buddies for you. Here are the candidates:</p>
                <div id="candidatesContainer" class="row">
                  <!-- Candidate cards will be populated here -->
                </div>
                <hr style="border-color: rgba(255,255,255,0.3);">
                <p class="mb-0">Click "Send Request" on any buddy to connect. If they accept, you'll be able to start studying together!</p>
              </div>
            </div>

            <!-- No Match Found -->
            <div id="noMatch" style="display: none;">
              <div class="alert alert-warning" style="border-radius: 15px; border: none;">
                <h4 class="alert-heading"><i class="fas fa-search me-2"></i>No Suitable Buddy Found</h4>
                <p class="mb-3">We couldn't find a study buddy that matches your preferences right now.</p>
                <div class="suggestions">
                  <h6>Try these suggestions:</h6>
                  <ul class="mb-0">
                    <li>Update your study preferences to be more flexible</li>
                    <li>Add more subjects or availability times</li>
                    <li>Check back later as more students join</li>
                  </ul>
                </div>
                <hr>
                <div class="text-center">
                  <a href="/profile" class="btn btn-outline-primary">Update Preferences</a>
                </div>
              </div>
            </div>

            <!-- Error Message -->
            <div id="matchError" style="display: none;">
              <div class="alert alert-danger" style="border-radius: 15px; border: none;">
                <h4 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Something Went Wrong</h4>
                <p class="mb-0" id="errorMessage">Please try again later or contact support if the problem persists.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tips Card -->
      <div class="card" style="border-radius: 20px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <div class="card-body p-4">
          <h5 class="mb-3"><i class="fas fa-lightbulb text-warning me-2"></i>Buddy Matching Tips</h5>
          <div class="row">
            <div class="col-md-6">
              <div class="tip-item mb-3">
                <i class="fas fa-users text-primary me-2"></i>
                <strong>Be specific:</strong> The more detailed your preferences, the better your match!
              </div>
              <div class="tip-item mb-3">
                <i class="fas fa-clock text-info me-2"></i>
                <strong>Timezone matters:</strong> We match based on compatible timezones.
              </div>
            </div>
            <div class="col-md-6">
              <div class="tip-item mb-3">
                <i class="fas fa-handshake text-success me-2"></i>
                <strong>Shared goals:</strong> Buddies with similar objectives study better together.
              </div>
              <div class="tip-item">
                <i class="fas fa-sync text-secondary me-2"></i>
                <strong>Keep trying:</strong> If no match is found, update your preferences and try again.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.preference-item {
  padding: 15px;
  background: #f8f9fa;
  border-radius: 10px;
  border-left: 4px solid #667eea;
}

.match-result {
  animation: fadeIn 0.5s ease-in;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.buddy-card {
  transition: transform 0.3s ease;
}

.buddy-card:hover {
  transform: translateY(-2px);
}

.tip-item {
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
}

.tip-item:last-child {
  border-bottom: none;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4) !important;
}

.spinner-border {
  animation: spinner-border 0.75s linear infinite;
}
</style>

<script>
document.getElementById('findBuddyBtn').addEventListener('click', async function() {
  const btn = this;
  const spinner = document.getElementById('loadingSpinner');
  const result = document.getElementById('matchResult');

  // Hide previous results
  result.style.display = 'none';
  document.getElementById('matchSuccess').style.display = 'none';
  document.getElementById('noMatch').style.display = 'none';
  document.getElementById('matchError').style.display = 'none';

  // Show loading
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Finding Buddy...';
  spinner.style.display = 'block';

  try {
    const response = await fetch('/buddy-match', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    });

    const data = await response.json();

    if (response.ok) {
      if (data.candidates && data.candidates.length > 0) {
        // Show success with candidates
        displayCandidates(data.candidates);
      } else {
        // No match found
        document.getElementById('noMatch').style.display = 'block';
      }
    } else {
      // Show error
      document.getElementById('errorMessage').textContent = data.message || 'An error occurred';
      document.getElementById('matchError').style.display = 'block';
    }
  } catch (error) {
    console.error('Error:', error);
    document.getElementById('errorMessage').textContent = 'Network error. Please try again.';
    document.getElementById('matchError').style.display = 'block';
  } finally {
    // Hide loading
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-search me-2"></i>Find Study Buddy';
    spinner.style.display = 'none';
    result.style.display = 'block';
  }
});

function displayCandidates(candidates) {
  const successDiv = document.getElementById('matchSuccess');
  const container = document.getElementById('candidatesContainer');
  container.innerHTML = ''; // Clear previous content

  candidates.forEach(candidate => {
    const colDiv = document.createElement('div');
    colDiv.className = 'col-md-6 mb-3';

    const cardDiv = document.createElement('div');
    cardDiv.className = 'buddy-card p-3';
    cardDiv.style.background = 'rgba(255,255,255,0.1)';
    cardDiv.style.borderRadius = '10px';

    cardDiv.innerHTML = `
      <div class="d-flex align-items-center mb-3">
        <div style="width: 50px; height: 50px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 10px;">
          <i class="fas fa-user fa-lg" style="color: white;"></i>
        </div>
        <div>
          <h6 class="mb-1" style="color: white;">${candidate.firstName} ${candidate.lastName}</h6>
          <p class="mb-0 small" style="color: rgba(255,255,255,0.8);">${candidate.email}</p>
        </div>
      </div>
      <div class="buddy-details mb-3">
        <div class="row">
          <div class="col-12 mb-2">
            <strong style="color: white;">Shared Subjects:</strong>
            <div class="mt-1">
              ${candidate.studyPreferences && candidate.studyPreferences.subjects ?
                candidate.studyPreferences.subjects.map(subject => `<span class="badge bg-primary me-1">${subject}</span>`).join('') :
                '<span class="text-muted small">No subjects specified</span>'}
            </div>
          </div>
          <div class="col-12">
            <strong style="color: white;">Shared Availability:</strong>
            <div class="mt-1">
              ${candidate.studyPreferences && candidate.studyPreferences.availability ?
                candidate.studyPreferences.availability.map(time => `<span class="badge bg-info me-1">${time}</span>`).join('') :
                '<span class="text-muted small">No availability specified</span>'}
            </div>
          </div>
        </div>
      </div>
      <button class="btn btn-light btn-sm w-100 sendRequestBtn" data-user-id="${candidate._id}">
        <i class="fas fa-paper-plane me-1"></i>Send Request
      </button>
    `;

    colDiv.appendChild(cardDiv);
    container.appendChild(colDiv);
  });

  // Add event listeners to send request buttons
  document.querySelectorAll('.sendRequestBtn').forEach(btn => {
    btn.addEventListener('click', async function() {
      const userId = this.getAttribute('data-user-id');
      await sendBuddyRequest(userId, this);
    });
  });

  successDiv.style.display = 'block';
}

async function sendBuddyRequest(userId, button) {
  button.disabled = true;
  button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Sending...';

  try {
    const response = await fetch('/buddy-match/request', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ buddyId: userId })
    });

    const data = await response.json();

    if (response.ok) {
      button.className = 'btn btn-success btn-sm w-100';
      button.innerHTML = '<i class="fas fa-check me-1"></i>Request Sent!';
    } else {
      button.className = 'btn btn-danger btn-sm w-100';
      button.innerHTML = '<i class="fas fa-times me-1"></i>Failed';
      setTimeout(() => {
        button.disabled = false;
        button.className = 'btn btn-light btn-sm w-100';
        button.innerHTML = '<i class="fas fa-paper-plane me-1"></i>Send Request';
      }, 2000);
    }
  } catch (error) {
    console.error('Error:', error);
    button.className = 'btn btn-danger btn-sm w-100';
    button.innerHTML = '<i class="fas fa-times me-1"></i>Failed';
    setTimeout(() => {
      button.disabled = false;
      button.className = 'btn btn-light btn-sm w-100';
      button.innerHTML = '<i class="fas fa-paper-plane me-1"></i>Send Request';
    }, 2000);
  }
}
</script>
