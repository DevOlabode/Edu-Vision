<% layout('layout/boilerplate.ejs') %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="card shadow-lg border-0" style="border-radius: 22px;">
        <div class="card-body p-5">
          <h2 class="mb-3" style="font-weight: 700; color: #2c3e50;">
            <i class="fas fa-book-open me-2"></i><%= material.title %>
          </h2>
          <div class="mb-3">
            <span class="badge bg-primary me-2">Type: <%= material.fileType.toUpperCase() %></span>
            <span class="badge bg-secondary me-2">Size: <%= (material.fileSize / 1024).toFixed(2) %> KB</span>
            <span class="badge bg-success">Status: <%= material.status %></span>
          </div>
          <p class="mb-4" style="color: #495057; font-size: 1.1rem;">
            <%= material.description || 'No description provided.' %>
          </p>
          <div class="mb-4">
            <strong>Uploaded by:</strong>
            <a href="/users/<%= material.uploadedBy._id %>" class="text-decoration-none">
              <%= material.uploadedBy.firstName %> <%= material.uploadedBy.lastName %>
            </a>
            <span class="text-muted ms-2">on <%= new Date(material.createdAt).toLocaleDateString() %></span>
          </div>
          <% if (material.summary) { %>
            <div class="mb-4">
              <h5 class="fw-bold">Summary</h5>
              <div class="bg-light p-3 rounded" style="font-size: 1.05rem; color: #333;">
                <%= material.summary %>
              </div>
            </div>
          <% } %>
          <div class="mt-4">
            <a href="https://res.cloudinary.com/<your-cloud-name>/raw/upload/<%= material.cloudinaryId %>" target="_blank" class="btn btn-outline-primary me-2">
              <i class="fas fa-download me-1"></i>Download File
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.card {
  border-radius: 22px;
}
</style>
